# MongoDB connection (required unless using `npm run dev:local`)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=morgan

# Server
PORT=4173
# Set to 1 when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=0

# Server-only Resend email delivery (https://resend.com). For local testing, use a sender
# permitted by your Resend account; onboarding@resend.dev only reaches the account owner.
RESEND_API_KEY=
MAIL_FROM=
RESEND_TEST_TO=seif.a7@icloud.com
# Explicit local-only switches. Never set these in a production environment.
MORGAN_EMAIL_TEST_OVERRIDE=0
MORGAN_EMAIL_PREVIEW=0

# Public origin used in password-reset links (required for password reset, with email).
APP_URL=

# Optional server-side admin identity. The matching account's role is stored in MongoDB.
MORGAN_ADMIN_EMAIL=
