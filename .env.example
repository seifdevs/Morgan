# MongoDB connection (required unless using `npm run dev:local`)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=morgan

# Server
PORT=4173
# Set to 1 when running behind a reverse proxy (correct client IPs for rate limiting)
TRUST_PROXY=0

# Optional: invoice email delivery via Resend (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
MAIL_FROM=

# Public origin used in password-reset links (required for password reset, with email).
APP_URL=
