{
  "name": "morgan-financial-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "dev:local": "node --env-file-if-exists=.env server/local.mjs",
    "test:resend": "node --env-file-if-exists=.env scripts/test-resend.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^4.22.3",
    "mongodb": "^7.7.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
